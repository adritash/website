# Server-side Gemini API key (never expose to the browser)
GEMINI_API_KEY=

# Gemini File Search store resource name (server-side only)
# Example: fileSearchStores/adritash-knowledge-abc123
GEMINI_FILE_SEARCH_STORE=

# Contact form recipient override (optional; defaults to contact@adritash.com)
CONTACT_EMAIL=

# Public site URL (optional)
NEXT_PUBLIC_SITE_URL=https://adritash.com

# Upstash Redis for distributed rate limiting (optional)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Resend API key for contact form
RESEND_API_KEY=
