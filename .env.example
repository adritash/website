# ─────────────────────────────────────────────────────────────────────────────
# ADRITASH website + Pulse. Copy to .env.local (Next.js) / .env (worker, Prisma).
# Never commit real values. Never put secrets in NEXT_PUBLIC_* variables.
# ─────────────────────────────────────────────────────────────────────────────

# Existing website
RESEND_API_KEY=
CONTACT_EMAIL=
GEMINI_API_KEY=
GEMINI_FILE_SEARCH_STORE=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_SITE_URL=https://www.adritash.com

# ── Pulse: core ──────────────────────────────────────────────────────────────
NODE_ENV=development
# Pulse routes return 404 and the worker refuses to start until this is true.
PULSE_ENABLED=false
LOG_LEVEL=info
NEXT_PUBLIC_APP_URL=https://www.adritash.com

# PostgreSQL (pooled URL for the app; DIRECT_URL used by migrations if set)
DATABASE_URL=postgresql://user:password@host:5432/pulse
DIRECT_URL=
PULSE_DB_POOL_MAX=5

# Redis (fixed-price instance recommended for BullMQ)
REDIS_URL=redis://default:password@host:6379

# 32-byte keys, base64. Generate each with: openssl rand -base64 32
PULSE_ENCRYPTION_KEY=
PULSE_PHONE_HASH_KEY=
# Long random strings. Generate with: openssl rand -base64 48
PULSE_SESSION_SECRET=
ADMIN_AUTH_SECRET=

# ── AI (intent interpretation only) ──────────────────────────────────────────
# none = deterministic rules only; gemini = rules first, Gemini for the rest
AI_PROVIDER=none
AI_MODEL=gemini-3.6-flash
AI_DAILY_REQUESTS_PER_USER=30
AI_TIMEOUT_MS=8000

# ── WhatsApp Business Platform (Cloud API) ───────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v27.0
WHATSAPP_TEMPLATE_LANGUAGE=en
# Meta's limit on unique users messaged outside the 24h window (250 until verified)
WHATSAPP_DAILY_UNIQUE_LIMIT=250
WHATSAPP_TIMEOUT_MS=10000
# Public number for the click-to-chat button, digits only with country code
NEXT_PUBLIC_PULSE_WHATSAPP_NUMBER=

# ── Market data ──────────────────────────────────────────────────────────────
# none | eodhd | sandbox (sandbox = fake test data, refused in production)
MARKET_DATA_PROVIDER=none
MARKET_DATA_API_KEY=
MARKET_DATA_TIMEOUT_MS=6000
MARKET_DATA_CACHE_SECONDS=60
MARKET_DATA_STALE_AFTER_MINUTES=45
MARKET_DATA_DELAY_MINUTES=15

# ── Payments (keep disabled until the cost review passes) ────────────────────
PULSE_PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=none
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Cost model (INR excl. GST; verify against current rate cards) ────────────
PULSE_COST_WHATSAPP_UTILITY_INR=0.115
PULSE_COST_WHATSAPP_MARKETING_INR=0.8631
PULSE_COST_WHATSAPP_SERVICE_INR=0
PULSE_COST_AI_REQUEST_INR=0.02
PULSE_COST_MARKET_DATA_CALL_INR=0
PULSE_DAILY_COST_ALERT_INR=500

# ── Limits, retention, operations ────────────────────────────────────────────
PULSE_MESSAGE_RETENTION_DAYS=30
PULSE_INBOUND_PER_USER_PER_10_MIN=30
OPS_ALERT_EMAIL=
WORKER_HEALTH_PORT=
